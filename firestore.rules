rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 把两个邮箱换成真实的登录邮箱（全部小写）
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'yangxinyue119@gmail.com';
    }
    function isViewer() {
      return request.auth != null
        && request.auth.token.email in ['yangxinyue119@gmail.com', 'zhangluxin08@gmail.com'];
    }
    match /{document=**} {
      allow read: if isViewer();
      allow write: if isOwner();
    }
  }
}
