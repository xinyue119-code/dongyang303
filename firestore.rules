rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 这两个账号都能看、也都能改（邮箱全部小写，和 config.js 里的 EDITOR_EMAILS 保持一致）
    function isMember() {
      return request.auth != null
        && request.auth.token.email in ['yangxinyue119@gmail.com', 'zhangluxin08@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if isMember();
    }
  }
}
